# Digital Trophy MVP - Configuration

# Application
APP_NAME=Digital Trophy MVP
APP_VERSION=0.1.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://trophy_user:trophy_pass@localhost:5432/trophy_db

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Upload
MAX_FILE_SIZE_MB=500
UPLOAD_DIR=/app/uploads

# CORS
ALLOWED_ORIGINS=["http://localhost:8000"]
